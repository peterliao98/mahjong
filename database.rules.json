{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      ".indexOn": [
        "open"
      ],
      "$code": {
        ".write": "auth != null && (!newData.exists() || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid"
        },
        "seats": {
          ".read": "auth != null",
          "$i": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)",
            ".validate": "$i.matches(/^[0-3]$/) && (!newData.exists() || newData.child('name').val().length <= 8)"
          }
        },
        "online": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "view": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "act": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.provider === 'password' && auth.token.email_verified === true"
      }
    }
  }
}
